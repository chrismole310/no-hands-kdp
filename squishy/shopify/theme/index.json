    "values_deskloaf": {
      "type": "hero",
      "name": "t:names.hero",
      "blocks": {
        "v1": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<h3>Curated, not dumped.</h3><p>Three pieces that go together, picked by hand. No thirty-pack of random mochi.</p>",
            "text_color": "{{ settings.color_palette.color1 }}",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
