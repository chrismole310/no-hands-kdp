            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "v2": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<h3>Certified.</h3><p>Every item is a tested children's product with a certificate on file. No water beads, no gel dupes, no knock-off characters.</p>",
            "text_color": "{{ settings.color_palette.color1 }}",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "line_height": "normal",
