        "text_sub": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>Slow-rebound silicone tabas, jumbo slow-rise pastries and one very calm capybara. Curated into three-piece sets, tested to US toy safety standards, and shipped free.</p>",
