            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "v3": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<h3>Made for desks, stolen by kids.</h3><p>Ages 6 and up. We just assume the adult ordered it for themselves.</p>",
            "text_color": "{{ settings.color_palette.color1 }}",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "v4": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p><em>How a taba works:</em> taba squishies are cast silicone, not foam. They stick slightly to your fingers, stretch, and rebound slowly, and unlike foam they don't crack or lose their rise. That's why we lead with them.</p>",
            "text_color": "{{ settings.color_palette.color1 }}",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
